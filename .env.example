# =============================================================================
# Snake Classic — Flutter app environment
# =============================================================================
#
# Copy to `.env` and fill in real values. `.env` is gitignored; this template
# is committed and is the canonical list of what the app expects.
#
# -----------------------------------------------------------------------------
# READ THIS BEFORE ADDING A KEY: .env SHIPS INSIDE THE APP
# -----------------------------------------------------------------------------
#
# `.env` is declared as a Flutter ASSET in pubspec.yaml:
#
#     assets:
#       - .env
#
# so it is packed into the APK/AAB and installed on every player's device.
# Verified against a real build — the bundle contains
# `base/assets/flutter_assets/.env`. Anyone can download the app from Play,
# unzip it, and read this file in full. Obfuscation does not help: assets are
# data, not code.
#
# Therefore, ONLY put values here that are safe to publish:
#
#   SAFE      public client identifiers, public endpoint URLs — things the
#             app would reveal anyway the first time it makes a request
#
#   NOT SAFE  API keys, auth tokens, signing keys, service-account files,
#             database credentials, anything with write access to a system
#
# A secret needed at BUILD time (not run time) belongs in a gitignored file
# that is not an asset — see the Sentry note at the bottom for the pattern.
#
# =============================================================================


# -----------------------------------------------------------------------------
# Google Sign-In
# -----------------------------------------------------------------------------
# OAuth 2.0 WEB client id from the Firebase project (snake-classic-2a376) —
# Google Cloud Console → APIs & Services → Credentials → "Web client".
#
# The web client id, not the Android one: google_sign_in needs it as the
# serverClientId so the backend can verify the resulting ID token. It is
# public by design — it appears in every OAuth redirect.
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id-here


# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
# Which one is used is decided at runtime by build mode, not by editing this
# file: release builds use PROD, debug/profile builds use DEV.
#
# DEV must be reachable FROM THE PHONE, so `localhost` will not work — that
# resolves to the handset itself. Use your machine's LAN address (the API
# listens on 0.0.0.0:8393), or 10.0.2.2 for the Android emulator.
DEV_API_BACKEND_URL=http://192.168.0.141:8393

# Public production API, behind Traefik + Let's Encrypt.
PROD_API_BACKEND_URL=https://snakeclassic.pranta.dev


# -----------------------------------------------------------------------------
# What deliberately does NOT belong here
# -----------------------------------------------------------------------------
# SENTRY_AUTH_TOKEN — do not add it. It is a write credential for the Sentry
# org, and this file is published inside the app (see the header). It is also
# only needed at BUILD time, never at run time, so the app has no reason to
# carry it at all.
#
# It lives in `.sentry-auth-token` at the repo root instead: gitignored, not
# an asset, and read automatically by tools/release_android.sh and
# tools/release_android.ps1. Both scripts REFUSE to build if they find a
# non-empty SENTRY_AUTH_TOKEN in this file.
#
# The app's Sentry DSN is not here either — it is a compile-time constant in
# lib/core/observability/sentry_bootstrap.dart. A DSN is write-only ingest,
# not a credential, and keeping it in source means a fresh clone cannot
# accidentally build with crash reporting silently switched off.
