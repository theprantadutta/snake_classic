<?xml version="1.0" encoding="utf-8"?>
<!--
  Hand-maintained brand colours.

  Deliberately NOT in colors.xml: that file is regenerated by
  flutter_launcher_icons (it owns ic_launcher_background), so anything added
  there is at the mercy of the next `dart run flutter_launcher_icons`.
-->
<resources>
    <!-- Tint Android applies to the notification small icon and the app name
         in the shade. Mirrors NotificationService._brandColor — keep the two
         in step. -->
    <color name="notification_accent">#9BBD0F</color>
</resources>
