		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<!-- Languages the app ships (must mirror SupportedLocales.locales).
		     Without this iOS treats the bundle as English-only: the App Store
		     listing shows one language, and -[NSBundle preferredLocalizations]
		     hands Flutter "en" no matter what the device is set to, so the
		     ARB translations would never be reached on iOS. -->
